{
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    timezone: 'Europe/Berlin',
    // first of each month
    schedule: ['* * 1 * *'],
    enabledManagers: ['github-actions'],
    packageRules: [
        { groupName: 'github actions', matchManagers: ['github-actions'] },
    ],
}
